# Copy to .env and fill in from your IBM Verify tenant.
# .env is git-ignored and must never be committed.

VERIFY_TENANT=yourtenant.verify.ibm.com
VERIFY_DISCOVERY_URL=https://yourtenant.verify.ibm.com/v1.0/endpoint/default/.well-known/openid-configuration

# Applications > Applications > <your app> > Sign-on tab
VERIFY_CLIENT_ID=
VERIFY_CLIENT_SECRET=

# Must match a Redirect URI registered on the Sign-on tab, exactly
VERIFY_REDIRECT_URI=http://localhost:8000/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
